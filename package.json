{
  "name": "moderato",
  "version": "1.0.0",
  "description": "Content moderation, in tempo. Wrap any input, image picker, or upload with allow / review / block screening \u2014 OpenAI omni-moderation, your own endpoint, or offline rules. Client for speed, server for truth.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs"
    },
    "./web": {
      "types": "./dist/web/index.d.ts",
      "import": "./dist/web/index.js",
      "require": "./dist/web/index.cjs"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js",
      "require": "./dist/server/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wiggapony0925/moderato.git"
  },
  "homepage": "https://github.com/wiggapony0925/moderato#readme",
  "bugs": {
    "url": "https://github.com/wiggapony0925/moderato/issues"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "prepare": "npm run build",
    "verify:package": "node scripts/verify-package.mjs",
    "rehearse": "node scripts/rehearse.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "docs:start": "npm --prefix docs run start",
    "docs:build": "npm run build && npm --prefix docs run build",
    "docs:version": "npm --prefix docs run version",
    "bench": "node bench/run.mjs",
    "cycle": "node bench/cycle.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build && npm run verify:package && npm run rehearse && npm run check:docs"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "~19.2.10",
    "jsdom": "^26.1.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tsup": "^8.5.0",
    "typescript": "~5.9.2",
    "vitest": "^4.1.9"
  },
  "keywords": [
    "moderation",
    "content-moderation",
    "trust-and-safety",
    "hate-speech",
    "profanity-filter",
    "openai",
    "omni-moderation",
    "react",
    "react-hook",
    "image-moderation",
    "video-moderation",
    "nsfw",
    "ugc"
  ]
}
